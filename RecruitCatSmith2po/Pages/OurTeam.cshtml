@page
@model RecruitCatSmith2po.Pages.OurTeamModel
@{
    ViewData["Title"] = "Our Team";
}

<div class="text-center mb-5">
    <h1>Our Team</h1>
    <p class="lead">
        Meet the professionals who help connect talented people with the right opportunities.
    </p>
</div>

<div class="row g-4">

    <div class="col-md-4">
        <div class="card h-100">
            <img src="~/images/Profile2.png"
                 class="card-img-top"
                 alt="Payton Smith"
                 style="height: 300px; object-fit: cover;">

            <div class="card-body">
                <h5 class="card-title">Payton Smith</h5>
                <h6 class="card-subtitle mb-2 text-muted">
                    Production & Technology Recruiting Specialist
                </h6>
                <p class="card-text">
                    Payton brings experience in production planning, technology, and data-driven problem solving.
                    He focuses on helping candidates find opportunities where technical and operational skills can make an impact.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <img src="~/images/jordan-avatar.png"
                 class="card-img-top"
                 alt="Jordan Lee"
                 style="height: 300px; object-fit: cover;">

            <div class="card-body">
                <h5 class="card-title">Jordan Lee</h5>
                <h6 class="card-subtitle mb-2 text-muted">
                    Technical Recruiting Manager
                </h6>
                <p class="card-text">
                    Jordan specializes in recruiting for software, engineering, and information technology roles.
                    He works closely with candidates to understand their skills and long-term career goals.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <img src="~/images/maria-avatar.png"
                 class="card-img-top"
                 alt="Maria Chen"
                 style="height: 300px; object-fit: cover;">

            <div class="card-body">
                <h5 class="card-title">Maria Chen</h5>
                <h6 class="card-subtitle mb-2 text-muted">
                    Client Relations Manager
                </h6>
                <p class="card-text">
                    Maria works with employers to understand their hiring needs and build recruiting strategies
                    that connect organizations with qualified candidates.
                </p>
            </div>
        </div>
    </div>

</div>