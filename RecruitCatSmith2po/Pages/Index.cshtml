@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">RecruitCatSmith2po</h1>

    <p class="lead">
        Connecting talented professionals with opportunities where they can succeed.
    </p>

    <p class="text-muted">
        Specialized recruiting for technology, engineering, manufacturing, and business professionals.
    </p>

    <a href="#services" class="btn btn-primary btn-lg mt-2">
        Explore Our Services
    </a>
</div>

<hr class="my-5">

<div class="row mb-5">
    <div class="col-md-6">
        <h2>About RecruitCatSmith2po</h2>
        <p>
            RecruitCatSmith2po connects skilled professionals with organizations
            looking for talent in technology, engineering, manufacturing, and business.
            We focus on understanding both candidate goals and employer needs to create
            stronger career matches.
        </p>
    </div>

    <div class="col-md-6">
        <h2>Contact Us</h2>
        <p>
            <strong>Address:</strong> 123 Career Way, Cincinnati, OH 45202<br>
            <strong>Phone:</strong> (513) 555-0123
        </p>
    </div>
</div>

<section id="services" class="mb-5">
    <div class="text-center mb-4">
        <h2>Our Services</h2>
        <p class="text-muted">
            Recruiting solutions for professionals and employers.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Career Placement</h5>
                    <p class="card-text">
                        We help professionals identify opportunities that align
                        with their experience, skills, and career goals.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Talent Recruiting</h5>
                    <p class="card-text">
                        We help organizations identify qualified candidates for
                        technical, operational, and business positions.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Career Guidance</h5>
                    <p class="card-text">
                        Candidates receive guidance on matching their experience
                        and professional goals with suitable opportunities.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>

<section class="mb-5">
    <div class="row align-items-center g-4">

        <div class="col-md-6">
            <h2>Industries We Serve</h2>

            <ul class="list-group">
                <li class="list-group-item">Technology</li>
                <li class="list-group-item">Engineering</li>
                <li class="list-group-item">Manufacturing</li>
                <li class="list-group-item">Business Operations</li>
            </ul>
        </div>

        <div class="col-md-6">
            <img src="~/images/recruiting-team.jpg"
                 class="img-fluid rounded"
                 alt="Recruiting professionals working together">
        </div>

    </div>
</section>

<hr class="my-5">

<section class="mb-5">
    <div class="text-center mb-4">
        <h2>What Candidates Say</h2>
        <p class="text-muted">
            Helping professionals take the next step in their careers.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <p class="card-text">
                        "RecruitCatSmith2po took the time to understand my experience
                        and career goals. They helped me find an opportunity that was
                        a great fit for my skills."
                    </p>
                    <p class="fw-bold mb-0">— Alex R.</p>
                    <p class="text-muted">Engineering Professional</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <p class="card-text">
                        "The recruiting process was straightforward and professional.
                        I always knew what the next step was and felt prepared throughout
                        the interview process."
                    </p>
                    <p class="fw-bold mb-0">— Taylor M.</p>
                    <p class="text-muted">Technology Professional</p>
                </div>
            </div>
        </div>

    </div>
</section>

<section class="mb-5">
    <div class="text-center mb-4">
        <h2>How to Apply</h2>
        <p class="text-muted">
            Getting started with RecruitCatSmith2po is simple.
        </p>
    </div>

    <div class="row g-4 text-center">

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h5">1. Submit Your Resume</h3>
                    <p>
                        Send us your current resume and tell us what type of
                        opportunity you are looking for.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h5">2. Meet With a Recruiter</h3>
                    <p>
                        Our team will discuss your experience, skills, and
                        long-term career goals.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h5">3. Find Opportunities</h3>
                    <p>
                        We connect you with positions that align with your
                        qualifications and professional goals.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>

<hr class="my-5">

  
        