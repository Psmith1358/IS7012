@page
@model Exercise2.Pages_Industries.CreateModel

@{
    ViewData["Title"] = "Create a New Industry";
}

<h1>Create a New Industry</h1>

<h4>Industry</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Industry.IndustryName"
                       class="control-label"></label>
                <input asp-for="Industry.IndustryName"
                       class="form-control" />
                <span asp-validation-for="Industry.IndustryName"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Create Industry"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="Index">Back to All Industries</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}