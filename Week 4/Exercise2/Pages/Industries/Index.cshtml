@page
@model Exercise2.Pages_Industries.IndexModel

@{
    ViewData["Title"] = "All Industries";
}

<h1>All Industries</h1>

<p>
    <a asp-page="Create">Create New Industry</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Industry[0].IndustryName)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Industry)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IndustryName)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>