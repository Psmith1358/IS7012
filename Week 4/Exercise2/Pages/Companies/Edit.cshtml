@page
@model Exercise2.Pages_Companies.EditModel

@{
    ViewData["Title"] = "Edit Company";
}

<h1>Edit Company</h1>

<h4>@Model.Company.CompanyName</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Company.Id" />

            <div class="form-group mb-3">
                <label asp-for="Company.CompanyName" class="control-label"></label>
                <input asp-for="Company.CompanyName" class="form-control" />
                <span asp-validation-for="Company.CompanyName"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Company.Location" class="control-label"></label>
                <textarea asp-for="Company.Location"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Company.Location"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Company.IndustryId" class="control-label"></label>
                <select asp-for="Company.IndustryId"
                        class="form-control"
                        asp-items="ViewBag.IndustryId">
                    <option value="">Select an industry</option>
                </select>
                <span asp-validation-for="Company.IndustryId"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Save Changes"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Details" asp-route-id="@Model.Company.Id">View Details</a> |
    <a asp-page="./Index">Back to All Companies</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}