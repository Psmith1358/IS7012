@page
@model Exercise2.Pages_JobTitles.CreateModel

@{
    ViewData["Title"] = "Create a New Job Title";
}

<h1>Create a New Job Title</h1>

<h4>Job Title</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="JobTitle.TitleName"
                       class="control-label"></label>
                <input asp-for="JobTitle.TitleName"
                       class="form-control" />
                <span asp-validation-for="JobTitle.TitleName"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="JobTitle.Description"
                       class="control-label"></label>
                <textarea asp-for="JobTitle.Description"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="JobTitle.Description"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="JobTitle.CompanyId"
                       class="control-label"></label>
                <select asp-for="JobTitle.CompanyId"
                        class="form-control"
                        asp-items="ViewBag.CompanyId">
                    <option value="">Select a company</option>
                </select>
                <span asp-validation-for="JobTitle.CompanyId"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Create Job Title"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="Index">Back to All Job Titles</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
