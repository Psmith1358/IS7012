@page
@model Exercise2.Pages_JobTitles.EditModel

@{
    ViewData["Title"] = "Edit Job Title";
}

<h1>Edit Job Title</h1>

<h4>@Model.JobTitle.TitleName</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="JobTitle.Id" />

            <div class="form-group mb-3">
                <label asp-for="JobTitle.TitleName"
                       class="control-label"></label>
                <input asp-for="JobTitle.TitleName"
                       class="form-control" />
                <span asp-validation-for="JobTitle.TitleName"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="JobTitle.Description"
                       class="control-label"></label>
                <textarea asp-for="JobTitle.Description"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="JobTitle.Description"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="JobTitle.CompanyId"
                       class="control-label"></label>
                <select asp-for="JobTitle.CompanyId"
                        class="form-control"
                        asp-items="ViewBag.CompanyId">
                    <option value="">Select a company</option>
                </select>
                <span asp-validation-for="JobTitle.CompanyId"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Save Changes"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Details" asp-route-id="@Model.JobTitle.Id">View Details</a> |
    <a asp-page="./Index">Back to All Job Titles</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}