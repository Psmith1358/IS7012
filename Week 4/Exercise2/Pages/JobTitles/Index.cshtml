@page
@model Exercise2.Pages_JobTitles.IndexModel

@{
    ViewData["Title"] = "All Job Titles";
}

<h1>All Job Titles</h1>

<p>
    <a asp-page="Create">Create New Job Title</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.JobTitle[0].TitleName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobTitle[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobTitle[0].Company)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.JobTitle)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TitleName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Company!.CompanyName)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>